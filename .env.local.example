# ---------------------------------------------------------------------------
# Site URL — usado por app/robots.ts e app/sitemap.ts pra gerar URLs públicas.
# Em produção: https://app.longevify.com.br
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Concierge IA — todos opcionais. O Concierge tenta na ordem: Kimi → Anthropic
# → OpenAI → fallback scripted. Configure pelo menos um pra ter IA real.
# ---------------------------------------------------------------------------
KIMI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Supabase — optional. If both URL and anon key are unset the app runs in
# "demo mode": the proxy lets every request through and repositories return
# the local mock data from lib/mock-data.ts, lib/products.ts, etc.
# Fill these in once your Supabase project is provisioned.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-side only. Never expose to the browser. Used by
# admin-only server actions that need to bypass RLS (e.g. admin seeding).
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Stripe (Brasil) — opcional. Se STRIPE_SECRET_KEY estiver vazio, /planos roda
# em modo demo: o checkout pula direto pra página de sucesso sem cobrar.
# Atenção: nunca commit secret keys. Use chaves de teste em dev
# (sk_test_..., pk_test_..., whsec_...).
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Wearables OAuth — opcional. Sem essas vars, /wearables roda em modo demo:
# clicar "Conectar Oura/Whoop" abre modal "Em breve - finalizando integração"
# com link de waitlist. Apple Watch (XML upload) e Garmin (bridge/waitlist)
# funcionam mesmo sem essas vars.
# ---------------------------------------------------------------------------
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=
