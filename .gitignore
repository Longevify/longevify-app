# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local
!.env.local.example

# vercel
.vercel
.vercel/

# local node wrapper (lives in /bin/node, not committed)
bin/node

# typescript
*.tsbuildinfo
next-env.d.ts

# logs
*.log

# local Claude state
.claude/

# mobile (Capacitor)
mobile/node_modules/
mobile/ios/App/Pods/
mobile/ios/App/Podfile.lock
mobile/ios/App/App.xcodeproj/xcuserdata/
mobile/ios/App/App.xcworkspace/xcuserdata/
mobile/ios/DerivedData/
mobile/android/.gradle/
mobile/android/build/
mobile/android/app/build/
mobile/android/local.properties
mobile/android/.idea/
mobile/android/*.iml
mobile/android/app/release/
mobile/android/app/.cxx/
mobile/android/captures/
mobile/www/

