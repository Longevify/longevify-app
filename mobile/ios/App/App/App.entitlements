<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  App.entitlements — Longevify iOS

  HOW TO APPLY IN XCODE:
  1. Open ios/App/App.xcworkspace in Xcode
  2. Click the "App" target in the project navigator
  3. Go to "Signing & Capabilities" tab
  4. Click "+ Capability"
  5. Add "HealthKit"
  6. Xcode will merge these entitlements automatically.

  Alternatively, in Build Settings → Code Signing Entitlements,
  set the path to "App/App.entitlements".
-->
<plist version="1.0">
<dict>
	<!-- HealthKit — read/write health data -->
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.access</key>
	<array/>
	<!-- Push Notifications -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Change to "production" before App Store submission -->
</dict>
</plist>
